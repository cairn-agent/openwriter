{
  "name": "@openwriter/plugin-publish",
  "version": "0.1.0",
  "description": "OpenWriter Publish: your openwriter.io site, its screens and its tools",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && vite build --config client/vite.config.ts",
    "typecheck": "tsc -p client",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "openwriter": {
    "displayName": "Publish",
    "category": "publishing",
    "enabledByDefault": true
  },
  "files": [
    "dist/",
    "package.json"
  ]
}
